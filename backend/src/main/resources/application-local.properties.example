# File cấu hình mẫu cho môi trường Local
# Hướng dẫn: Copy file này thành 'application-local.properties' (nằm cùng thư mục) và điền mật khẩu SQL Server của bạn.
# File 'application-local.properties' đã nằm trong .gitignore, an toàn không bị lộ lên Git.

spring.application.name=fashion-store-backend

server.port=8080

# Cấu hình datasource kết nối SQL Server local
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=Fashion_Central;encrypt=true;trustServerCertificate=true
spring.datasource.username=sa
# Điền mật khẩu tài khoản sa của SQL Server trên máy bạn vào đây:
spring.datasource.password=123456789
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Sử dụng schema có sẵn, không tự tạo bảng
spring.jpa.hibernate.ddl-auto=none
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# CORS cho phép frontend kết nối (Vite mặc định cổng 5173)
app.cors.allowed-origins=http://localhost:5173

# Khóa bí mật JWT HS512 (chuỗi bí mật tối thiểu 64 bytes)
jwt.signerKey=dbItA/Z1RTFExd5j5wIWbAYa+zKg5YODeg2uTInnVuL0x32XP96v3HDj8Gr+gR5uQzngh+xpXxrsdoOhDL5iFw==
jwt.valid-duration=3600
jwt.refreshable-duration=604800

# Tự động tạo tài khoản có sẵn khi khởi động (admin, manager, staff với mật khẩu 123456)
app.bootstrap-accounts.enabled=true
app.bootstrap-accounts.password=123456
